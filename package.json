{
  "name": "corsentri-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "preview": "npx serve out",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prebuild": "npm run optimize:images",
    "lint": "eslint app scripts --max-warnings=0",
    "format": "prettier --write app scripts next.config.ts package.json",
    "format:check": "prettier --check app scripts next.config.ts package.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
